# LIBERO HDF5 root, containing libero_spatial/, libero_object/, libero_goal/,
# libero_90/, and libero_10/.
LIBERO_ROOT=/path/to/libero

# Optional source checkout used by the closed-loop evaluator.
LIBERO_HOME=/path/to/LIBERO

WANDB_MODE=disabled
DELTATOK_AUTO_DOWNLOAD_KINETICS_CKPT=0
DELTATOK_AUTO_PREPARE_ACTION_INIT=0
